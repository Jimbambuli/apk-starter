#!/usr/bin/make -f
# The native build installs into one private tree (its prefix is compiled into ART); nothing in it is a library
# of the system, so no shlibs/symbols for it, and no stripping (strip would break ART's .oat boot image, which
# the build has stripped already, ELF file by ELF file).
P = /usr/lib/apk-starter
# libopensles-standalone is built with -std=gnu23, which Ubuntu 24.04's default GCC 13 does not know (Debian 13: GCC 14 is
# the default anyway)
export CC = gcc-14
export CXX = g++-14

%:
	dh $@

# Ubuntu 24.04 has libunwind 1.6.2; bionic_translation asks for >= 1.8.0 (and so does native/meson.build). Where
# the system has less, the requirement is lowered to what is there, for this package build only (tried on Ubuntu 24.04).
override_dh_auto_configure:
	pkg-config --atleast-version=1.8.0 libunwind || sed -i "s/>=1.8.0/>=1.6.0/" native/meson.build native/subprojects/bionic_translation/meson.build
	meson setup obj native --prefix=$(P) --libdir=lib -Ddownload=false

override_dh_auto_build:
	meson compile -C obj

override_dh_auto_test:

override_dh_auto_install:
	meson install -C obj --no-rebuild --destdir $(CURDIR)/debian/apk-starter
	packaging/install-extras.sh $(CURDIR)/debian/apk-starter

override_dh_strip:
override_dh_dwz:
override_dh_makeshlibs:

override_dh_shlibdeps:
	dh_shlibdeps -l$(P)/lib:$(P)/lib/art
