<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Jimbambuli.ApkStarter</id>
  <name>APK Starter</name>
  <summary>Run Android apps on the Linux desktop</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.jimbambuli">
    <name translate="no">Jimbambuli</name>
  </developer>
  <description>
    <p>
      Runs Android apps from their APK files on the Linux desktop, built on Android Translation Layer (ATL).
    </p>
    <ul>
      <li>Open an APK, double-click it or add it to the application menu.</li>
      <li>List of installed apps with version and data size; start, uninstall, delete data.</li>
      <li>Aurora Store and microG can be set up on request from their official sources.</li>
      <li>Every start keeps a log; Debug records more.</li>
    </ul>
    <p>
      No apps are included. Only apps with x86_64 native code (or none) run; ARM-only apps do not.
    </p>
    <p>Android is a trademark of Google LLC.</p>
  </description>
  <launchable type="desktop-id">io.github.Jimbambuli.ApkStarter.desktop</launchable>
  <url type="homepage">https://github.com/Jimbambuli/apk-starter</url>
  <url type="bugtracker">https://github.com/Jimbambuli/apk-starter/issues</url>
  <screenshots>
    <screenshot type="default">
      <image>https://jimbambuli.github.io/apk-starter/screenshot.png</image>
      <caption>The app list with three free apps from F-Droid</caption>
    </screenshot>
    <!-- Placeholders: add when the images are online (docs/SCREENSHOTS.md)
    <screenshot><image>https://jimbambuli.github.io/apk-starter/screenshot-details.png</image></screenshot>
    <screenshot><image>https://jimbambuli.github.io/apk-starter/screenshot-aurora.png</image></screenshot>
    -->
  </screenshots>
  <content_rating type="oars-1.1"/>
  <releases>
    <!-- date and notes are set when the release is made -->
    <release version="0.1.0" date="2026-11-01"/>
  </releases>
</component>
